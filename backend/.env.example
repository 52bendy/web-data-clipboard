# Copy to .env for local use. Never commit real secrets.
# Configure sensitive values in Vercel Project Settings → Environment Variables or GitHub Secrets.
# Variables marked planned are inventory only; they are not currently enforced by this backend.

# Runtime
NODE_ENV=development # Runtime mode; production on Vercel.
PORT=3000 # Local Node server port (default: 3000; Vercel assigns its own port).

# Authentication/security (planned for REQ-202610-1252; not enforced yet)
API_SECRET_TOKEN= # Planned default: empty; bearer token for API authentication (not enforced yet).
ENFORCE_HTTPS=false # Planned default: disabled (not enforced yet).
TRUST_PROXY=false # Planned default: disabled (not enforced yet).
CONTENT_SECURITY_POLICY= # Planned default: unset (not enforced yet).
HSTS_MAX_AGE=31536000 # Planned default: one year; not enforced yet.
RATE_LIMIT_ENABLED=false # Planned default: disabled (not enforced yet).
RATE_LIMIT_PER_MINUTE=60 # Planned default: 60 requests; not enforced yet.
RATE_LIMIT_WINDOW_SECONDS=60 # Planned default: 60-second window; not enforced yet.

# Storage
STORAGE_DRIVER=memory # Implemented default; Upstash selection depends on A2 integration.
UPSTASH_REDIS_REST_URL= # Sensitive; required when the Upstash adapter is integrated and selected.
UPSTASH_REDIS_REST_TOKEN= # Sensitive; required when the Upstash adapter is integrated and selected.
STORAGE_KEY_PREFIX=dcc: # A2 adapter default; applies when the Upstash adapter is integrated.

# Clipboard (defaults from backend/src/services/clipboard-store.js)
CLIPBOARD_TTL_MS=1800000 # Latest clipboard record expires after 30 minutes.
CLIPBOARD_HISTORY_MAX_ENTRIES=500 # Keep up to 500 history records; 0 means unlimited.
CLIPBOARD_HISTORY_TTL_MS=86400000 # Keep history for 24 hours; 0 means unlimited.
CLIPBOARD_MAINTENANCE_INTERVAL_MS=60000 # Local development expiry sweep interval: 1 minute.

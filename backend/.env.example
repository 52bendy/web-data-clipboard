# Copy to .env and fill in for local development (never commit real values).
# The dev server reads process.env directly (see src/config.js).

# Shared secret devices send as the X-DCC-Token header (PRD §9.1).
# /api/v1/collect rejects every request while this is empty (fail closed).
API_SECRET_TOKEN=change-me

# HTTP port of the dev server.
PORT=3000

# Automatic extraction switch (PRD §4.2); false|0 disables it.
AUTO_EXTRACT=true

# Storage adapter (memory only until REQ-202610-1251).
STORAGE_DRIVER=memory

# Clipboard TTL and history retention (0 = unlimited for the history values).
CLIPBOARD_TTL_MS=1800000
CLIPBOARD_HISTORY_MAX_ENTRIES=500
CLIPBOARD_HISTORY_TTL_MS=86400000
CLIPBOARD_MAINTENANCE_INTERVAL_MS=60000

# Collect request limits: raw_content characters, request body bytes.
MAX_RAW_CONTENT_LENGTH=4096
MAX_BODY_BYTES=65536

# Admin log masking (PRD §8.2): enabled by default; false|0 shows raw senders.
MASK_SENDER=true

# Collection log retention (0 = unlimited). Bounded by count and age.
LOG_MAX_ENTRIES=1000
LOG_MAX_AGE_MS=604800000

# Devices seen within this window are reported online (default 24 hours).
DEVICE_ONLINE_THRESHOLD_MS=86400000

# Webhook delivery (REQ-202610-1258): per-attempt timeout, total attempts,
# exponential-backoff base delay, config cap and delivery-log retention.
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_BASE_DELAY_MS=1000
WEBHOOK_MAX_CONFIGS=20
WEBHOOK_MAX_DELIVERIES=200

# Admin dashboard auto-refresh cadence (REQ-202610-1261).
DASHBOARD_REFRESH_INTERVAL_MS=15000

# Security middleware (REQ-202610-1252).
ENFORCE_HTTPS=false
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60

# Admin login (REQ-202610-1260). Use a scrypt hash in production; if neither
# password source is set, /admin and the management APIs fail closed.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=scrypt$...
# ADMIN_PASSWORD=local-development-only
# ADMIN_SESSION_TTL_MS=28800000
# ADMIN_LOGIN_MAX_ATTEMPTS=5
# ADMIN_LOGIN_WINDOW_MS=900000
# ADMIN_MAX_SESSIONS=1000
# ADMIN_COOKIE_SECURE=auto
